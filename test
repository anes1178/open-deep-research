"""
read_confluence MCP 툴

흐름:
  1. ref_url → page_id 추출
  2. Confluence API로 storage HTML 가져오기
  3. HTML 파싱 (텍스트 + 이미지 placeholder + link_candidates)
  4. 이미지 병렬 캡셔닝 + ac:link 병렬 resolve (동시에)
  5. 토큰 trim (16K)
  6. 반환
"""

import asyncio
import re
from typing import Optional
from bs4 import BeautifulSoup, NavigableString, Tag
from dataclasses import dataclass, field
import tiktoken


# ------------------------------------------------------------------ #
# Data classes
# ------------------------------------------------------------------ #

@dataclass
class LinkCandidate:
    id: int
    type: str                            # "link" | "ac:link"
    anchor: Optional[str]
    url: Optional[str] = None
    content_title: Optional[str] = None
    space_key: Optional[str] = None


@dataclass
class ImageRef:
    placeholder: str   # "__IMG_0__"
    src: str


@dataclass
class ParseResult:
    text: str
    link_candidates: list[LinkCandidate]
    image_refs: list[ImageRef]


# ------------------------------------------------------------------ #
# Token trim
# ------------------------------------------------------------------ #

def trim_to_token_limit(text: str, max_tokens: int = 16000) -> str:
    enc = tiktoken.get_encoding("cl100k_base")
    tokens = enc.encode(text)
    if len(tokens) <= max_tokens:
        return text
    trimmed = enc.decode(tokens[:max_tokens])
    return trimmed + "\n\n[이하 내용 생략 - 토큰 한도 초과]"


# ------------------------------------------------------------------ #
# ref_url → page_id 추출
# ------------------------------------------------------------------ #

def extract_page_id(ref_url: str) -> Optional[str]:
    """
    지원 형식:
      - https://confluence.company.com/pages/12345
      - https://confluence.company.com/display/DEV/페이지제목
      - //go/conf/12345
    """
    # /pages/{id} 형식
    match = re.search(r"/pages/(\d+)", ref_url)
    if match:
        return match.group(1)

    # //go/conf/{id} 형식
    match = re.search(r"go/conf/(\d+)", ref_url)
    if match:
        return match.group(1)

    return None


# ------------------------------------------------------------------ #
# HTML 파서
# ------------------------------------------------------------------ #

def parse_confluence_html(
    storage_html: str,
    current_space_key: str = "",
) -> ParseResult:
    soup = BeautifulSoup(storage_html, "lxml-xml")

    segments: list[str] = []
    text_buffer: list[str] = []
    link_candidates: list[LinkCandidate] = []
    image_refs: list[ImageRef] = []
    image_exts = {".png", ".jpg", ".jpeg", ".gif", ".webp"}

    def commit():
        if text_buffer:
            joined = " ".join(text_buffer).strip()
            if joined:
                segments.append(joined)
            text_buffer.clear()

    def add_image(src: str) -> str:
        idx = len(image_refs)
        placeholder = f"__IMG_{idx}__"
        image_refs.append(ImageRef(placeholder=placeholder, src=src))
        return placeholder

    def add_link(type_: str, anchor: Optional[str], **kwargs) -> str:
        link_id = len(link_candidates) + 1
        link_candidates.append(
            LinkCandidate(id=link_id, type=type_, anchor=anchor, **kwargs)
        )
        return f"[LINK:{link_id}]"

    def replace_images_in_node(node: Tag) -> str:
        """테이블/ui-tab 내부 이미지를 placeholder로 치환한 raw HTML 반환"""
        node_copy = BeautifulSoup(str(node), "lxml-xml")
        for img in node_copy.find_all("img"):
            src = img.get("src", "")
            if src:
                img.replace_with(add_image(src))
        for att in node_copy.find_all("ri:attachment"):
            fname = att.get("ri:filename", "").lower()
            if any(fname.endswith(ext) for ext in image_exts):
                att.replace_with(add_image(fname))
        return str(node_copy)

    def walk(node, list_type: str = "", depth: int = 0, ol_counter: Optional[list] = None):
        if ol_counter is None:
            ol_counter = [0]

        for child in node.children:
            if isinstance(child, NavigableString):
                t = child.strip()
                if t:
                    text_buffer.append(t)
                continue

            if not child.name:
                continue

            name = child.name

            # 블록 요소
            if name in {"p", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote"}:
                commit()
                walk(child, list_type, depth, ol_counter)
                commit()

            # 리스트
            elif name == "ul":
                commit()
                walk(child, list_type="ul", depth=depth + 1, ol_counter=ol_counter)
                commit()

            elif name == "ol":
                commit()
                walk(child, list_type="ol", depth=depth + 1, ol_counter=[0])
                commit()

            elif name == "li":
                commit()
                indent = "  " * depth
                if list_type == "ol":
                    ol_counter[0] += 1
                    prefix = f"{indent}{ol_counter[0]}. "
                else:
                    prefix = f"{indent}- "
                text_buffer.append(prefix)
                walk(child, list_type, depth, ol_counter)
                commit()

            # 이미지 (단독)
            elif name == "img" and child.get("src"):
                commit()
                segments.append(add_image(child["src"]))

            elif name == "ri:attachment":
                fname = child.get("ri:filename", "").lower()
                if any(fname.endswith(ext) for ext in image_exts):
                    commit()
                    segments.append(add_image(fname))

            # 링크: <a>
            elif name == "a":
                href = child.get("href", "")
                if href:
                    anchor = child.get_text(" ", strip=True) or None
                    text_buffer.append(add_link("link", anchor=anchor, url=href))

            # 링크: <ac:link>
            elif name == "ac:link":
                ri_url = child.find("ri:url")
                ri_page = child.find("ri:page")
                body = child.find("ac:plain-text-link-body")
                anchor = body.get_text(strip=True) if body else None

                if ri_url:
                    href = ri_url.get("ri:value", "")
                    if href:
                        text_buffer.append(add_link("link", anchor=anchor, url=href))
                elif ri_page:
                    title = ri_page.get("ri:content-title", "")
                    space = ri_page.get("ri:space-key") or current_space_key
                    if title:
                        text_buffer.append(add_link(
                            "ac:link",
                            anchor=anchor or title,
                            content_title=title,
                            space_key=space,
                        ))

            # 코드 블록
            elif name == "ac:structured-macro" and child.get("ac:name") == "code":
                commit()
                lang_tag = child.find("ac:parameter", {"ac:name": "language"})
                lang = lang_tag.get_text(strip=True) if lang_tag else ""
                body_tag = child.find("ac:plain-text-body")
                code = body_tag.get_text(strip=True) if body_tag else ""
                if code:
                    segments.append(f"```{lang}\n{code}\n```")

            # 테이블 → raw HTML (내부 이미지만 placeholder 치환)
            elif name == "table":
                commit()
                for a in child.find_all("a", href=True):
                    add_link("link", anchor=a.get_text(" ", strip=True) or None, url=a["href"])
                for ac_link in child.find_all("ac:link"):
                    ri_page = ac_link.find("ri:page")
                    if ri_page:
                        title = ri_page.get("ri:content-title", "")
                        space = ri_page.get("ri:space-key") or current_space_key
                        if title:
                            add_link("ac:link", anchor=title, content_title=title, space_key=space)
                segments.append(replace_images_in_node(child))

            # ui-tabs → raw HTML (내부 이미지만 placeholder 치환)
            elif name == "ac:structured-macro" and child.get("ac:name") == "ui-tabs":
                commit()
                segments.append(replace_images_in_node(child))

            # draw.io
            elif name == "ac:structured-macro" and child.get("ac:name") == "drawio":
                commit()
                segments.append("[다이어그램: draw.io]")

            else:
                walk(child, list_type, depth, ol_counter)

    walk(soup.body or soup)
    commit()

    return ParseResult(
        text="\n\n".join(s for s in segments if s.strip()),
        link_candidates=link_candidates,
        image_refs=image_refs,
    )


