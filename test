@mcp.tool()
async def read_confluence(ref_url: str, query: str) -> str:
    """
    Confluence 페이지를 읽어서 내용을 반환합니다.
    
    LINK_CANDIDATES 섹션에 있는 링크 중 추가 탐색이 필요한 링크가 있으면
    해당 링크의 url을 ref_url로 넣어 다시 호출하세요.

    Args:
        ref_url: Confluence 페이지 URL
                 (https://confluence.../pages/12345 또는 //go/conf/링크)
        query: 사용자 질의 (페이지 내용 해석에 활용)
    """
    # 1. page_id 추출
    page_id = extract_page_id(ref_url)
    if not page_id:
        return f"page_id를 추출할 수 없습니다: {ref_url}"

    # 2. HTML 가져오기
    storage_html = await fetch_confluence_html(page_id)

    # 3. 파싱
    result = parse_confluence_html(storage_html)

    # 4. 이미지 캡셔닝 + ac:link resolve 병렬 처리
    ac_links = [lk for lk in result.link_candidates if lk.type == "ac:link"]

    caption_tasks = [caption_image(img.src) for img in result.image_refs]
    resolve_tasks = [resolve_ac_link(lk.content_title, lk.space_key) for lk in ac_links]

    all_results = await asyncio.gather(*caption_tasks, *resolve_tasks)

    captions = all_results[:len(caption_tasks)]
    resolved_urls = all_results[len(caption_tasks):]

    # 5. 이미지 placeholder → 캡션 텍스트 치환
    content = result.text
    for img_ref, caption in zip(result.image_refs, captions):
        content = content.replace(img_ref.placeholder, f"[이미지: {caption}]")

    # 6. ac:link url 채우기
    for lk, url in zip(ac_links, resolved_urls):
        lk.url = url

    # 7. LINK_CANDIDATES 섹션 추가
    if result.link_candidates:
        lines = ["=== LINK_CANDIDATES ==="]
        for lk in result.link_candidates:
            lines.append(
                f"LINK:{lk.id} | url={lk.url or 'None'} | anchor={lk.anchor}"
            )
        content += "\n\n" + "\n".join(lines)

    # 8. 토큰 trim
    return trim_to_token_limit(content, max_tokens=16000)
